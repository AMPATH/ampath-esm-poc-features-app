{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "extensions": [
    {
      "name": "hiv-summary-dashboard",
      "slot": "patient-chart-dashboard-slot",
      "component": "hivSummaryPatientChartLink",
      "meta": {
        "slot": "patient-chart-hiv-summary-dashboard-slot",
        "path": "hiv-summary",
        "layoutMode": "anchored"
      },
      "online": true,
      "offline": true
    },
    {
      "name": "hiv-summary",
      "slot": "patient-chart-hiv-summary-dashboard-slot",
      "component": "hivSummary",
      "order": 1,
      "meta": {
        "title": "Hiv Summary",
        "view": "hivSummary"
      },
      "online": true,
      "offline": true
    },
     {
      "name": "user-feedback-dashboard-link",
      "component": "userFeedbackLink",
      "slot": "app-menu-slot",
      "meta": {
        "name": "user-feedback",
        "slot": "user-feedback-dashboard-slot",
        "title": "Feedback"
      },
      "online": true,
      "offline": true
    },
    {
      "component": "userFeedbackForm",
      "name": "user-feedback",
      "slot": "user-feedback-dashboard-slot"
    },
     {
      "name": "clinical-notes-dashboard",
      "slot": "patient-chart-dashboard-slot",
      "component": "clinicalNotesPatientChartLink",
      "meta": {
        "slot": "patient-chart-clinical-notes-dashboard-slot",
        "path": "clinical-notes",
        "layoutMode": "anchored"
      },
      "online": true,
      "offline": true
    },
    {
      "name": "clinical-notes",
      "slot": "patient-chart-clinical-notes-dashboard-slot",
      "component": "clinicalNotes",
      "online": true,
      "offline": true
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "poc-features"
    }
  ]
}
