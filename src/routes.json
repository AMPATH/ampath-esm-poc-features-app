{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "Red box",
      "component": "redBox",
      "slot": "Boxes"
    },
    {
      "name": "hiv-summary-dashboard",
      "slot": "patient-chart-dashboard-slot",
      "component": "hivSummaryPatientChartLink",
      "meta": {
        "slot": "patient-chart-hiv-summary-dashboard-slot",
        "path": "hiv-summary",
        "layoutMode": "anchored"
      },
      "online": true,
      "offline": true
    },
    {
      "name": "hiv-summary",
      "slot": "patient-chart-hiv-summary-dashboard-slot",
      "component": "hivSummary",
      "order": 1,
      "meta": {
        "title": "Hiv Summary",
        "view": "hivSummary"
      },
      "online": true,
      "offline": true
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "root"
    }
  ]
}
